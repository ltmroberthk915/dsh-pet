{
  "name": "@ltmroberthk915/dsh-pet",
  "description": "鲸鱼娘多会话伴侣：每个活跃对话独立宠物、模型配色、tok/s 线性调速、完成待查看与共享亲密度。",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "icon": "icon.svg",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "test": "vitest run",
    "pet:cli": "node scripts/dsh-pet.cjs",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "prepare": "tsdown --config tsdown.prepare.config.ts",
    "build:local": "node scripts/build-local.mjs"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "desktop",
    "scripts/build-local.mjs",
    "cordis.patch.yml",
    "assets/whale-refined",
    "assets/decorations",
    "contracts",
    "icon.svg",
    "scripts/build-palettes.py",
    "LICENSE",
    "NOTICE",
    "docs/desktop-refined-pet.md"
  ],
  "license": "Apache-2.0",
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7-rc.1 || >=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 || >=0.2.0-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-util-time": "^0.1.7-rc.1",
    "@deepseek-ai/dsh-util-values": "^0.1.7-rc.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "pixi.js": "^8.19.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "untitled-pixi-live2d-engine": "1.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ltmroberthk915/dsh-pet.git"
  },
  "author": {
    "name": "ltmroberthk915",
    "url": "https://github.com/ltmroberthk915"
  },
  "homepage": "https://github.com/ltmroberthk915/dsh-pet#readme",
  "bugs": {
    "url": "https://github.com/ltmroberthk915/dsh-pet/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "pet",
    "desktop",
    "session"
  ],
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
